APP_NAME="Aqua-X-Foul Maritime Intelligence Platform"
APP_VERSION="1.0.0"
DEBUG=False

# For free hosting, you can either:
# 1. Leave as SQLite (zero setup required):
DATABASE_URL=sqlite:///./aquaxfoul.db
# 2. Or use a free PostgreSQL database from Render, Neon.tech, or Supabase:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

SECRET_KEY=aqua-xfoul-secret-key-2026-production-ready
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*
